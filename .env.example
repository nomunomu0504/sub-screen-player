# Copy to .env (ignored by git) and fill in. Never commit .env.
#
# Cloudflare, for deploying the site from this computer:
#   cd site && bun run build && bunx wrangler@4 deploy --env-file ../.env
# The Site workflow on GitHub uses repository secrets of the same names instead.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
