---
// A grid of what the built-in screens can look like, each with the command or setting that
// gives it. The pictures come from the repository's docs/images/ (also shown in the READMEs),
// copied into src/assets/screens/ by scripts/sync-docs.ts.
import { Image } from 'astro:assets';
import clockBig from '../assets/screens/clock-big.png';
import clockJa from '../assets/screens/clock-ja.png';
import clock from '../assets/screens/clock.png';
import dashboardClaudeCode from '../assets/screens/dashboard-claude-code.png';
import dashboardColors from '../assets/screens/dashboard-colors.png';
import dashboardCompact from '../assets/screens/dashboard-compact.png';
import dashboardMetrics from '../assets/screens/dashboard-metrics.png';
import dashboard from '../assets/screens/dashboard.png';

interface Props {
	lang?: 'en' | 'ja';
}

const { lang = 'en' } = Astro.props;

const screens = [
	{
		image: dashboard,
		title: { en: 'Dashboard', ja: 'ダッシュボード' },
		text: {
			en: 'The time with CPU, memory, network and disk use, and graphs of the last minute.',
			ja: '時刻と CPU・メモリ・ネットワーク・ディスクの使用状況を、直近1分のグラフ付きで。',
		},
		how: 'ssp dashboard',
	},
	{
		image: dashboardCompact,
		title: { en: 'Fewer panels', ja: 'パネルを絞る' },
		text: { en: 'Pick the panels and their order.', ja: '表示するパネルと順番を選べます。' },
		how: 'ssp dashboard --widgets clock,cpu,network',
	},
	{
		image: dashboardColors,
		title: { en: 'Your colors', ja: '色を変える' },
		text: { en: 'Text, graph and background colors, here without the clock.', ja: '文字・グラフ・背景の色を変えられます（この例は時計なし）。' },
		how: '[dashboard] color, accent, background',
	},
	{
		image: dashboardMetrics,
		title: { en: 'Your own figures', ja: '自分の数値' },
		text: {
			en: 'Any script can send a value, such as a CI status or a queue length, and show it as a panel.',
			ja: 'CI の状態やキューの長さなど、スクリプトから送った値をパネルとして並べられます。',
		},
		how: 'ssp metric set ci --value 2',
	},
	{
		image: dashboardClaudeCode,
		title: { en: 'Claude Code usage', ja: 'Claude Code の使用量' },
		text: {
			en: 'Tokens in the current 5-hour block and today, from the logs on your computer.',
			ja: '今の5時間ブロックと今日のトークン数を、手元のログから。',
		},
		how: 'ssp dashboard --widgets clock,claude-code',
	},
	{
		image: clock,
		title: { en: 'Clock', ja: '時計' },
		text: { en: 'The default screen when the daemon starts.', ja: 'デーモンを起動したときの既定の表示です。' },
		how: 'ssp clock',
	},
	{
		image: clockJa,
		title: { en: 'Japanese date', ja: '日本語の日付' },
		text: {
			en: 'Characters the built-in font lacks are drawn with a system font.',
			ja: '内蔵フォントにない文字は、OS に入っているフォントで描きます。',
		},
		how: '[clock] weekdays = ["日", "月", …]',
	},
	{
		image: clockBig,
		title: { en: 'Time only', ja: '時刻だけ' },
		text: { en: 'Just the time, large and in your color.', ja: '時刻だけを大きく、好きな色で。' },
		how: '[clock] seconds = false, date_format = ""',
	},
];
---

<ul class="screens not-content">
	{
		screens.map((screen) => (
			<li>
				<Image
					src={screen.image}
					alt={screen.title[lang]}
					widths={[640, 1280]}
					sizes="(min-width: 72rem) 34rem, (min-width: 50rem) 45vw, 100vw"
				/>
				<p class="title">{screen.title[lang]}</p>
				<p class="text">{screen.text[lang]}</p>
				<code>{screen.how}</code>
			</li>
		))
	}
</ul>

<style>
	.screens {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
		gap: 2rem 1.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0;
		min-width: 0;
	}
	img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	.title {
		margin: 0.75rem 0 0;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.text {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	code {
		display: inline-block;
		margin-top: 0.5rem;
		padding: 0.15rem 0.5rem;
		max-width: 100%;
		overflow-x: auto;
		white-space: nowrap;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-text-accent);
		background: var(--sl-color-gray-6);
		border-radius: 0.3rem;
	}
</style>
