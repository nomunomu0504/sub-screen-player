# Files that must never be committed. Keep secrets in the ignored files below; commit only the
# `*.example` templates next to them.

# --- Secrets and credentials ---------------------------------------------------------------
# Environment files (API tokens, e.g. CLOUDFLARE_API_TOKEN), at any depth.
.env
.env.*
*.env
!.env.example
!*.env.example
# Local variables of `wrangler dev`.
.dev.vars
.dev.vars.*
!.dev.vars.example
# Keys, certificates and other credential files.
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.asc
id_rsa*
id_ed25519*
id_ecdsa*
credentials*.json
service-account*.json
*secret*.json
*secrets*.toml
*.token
# Package manager settings, which can hold registry tokens.
.npmrc
.yarnrc
.yarnrc.yml
.pypirc
.cargo/credentials
.cargo/credentials.toml

# --- Local configuration and notes ----------------------------------------------------------
# Personal tool settings (mise tasks of the hardware tests, Claude Code's local permissions).
mise.local.toml
.mise.local.toml
mise.*.local.toml
.claude/settings.local.json
# Work trees of coding agents (Claude Code).
/.claude/worktrees/
# Drafts and notes that stay on this machine (release notes, announcement posts and so on).
/.private/
# Local configuration and captures.
/local/
*.pcap
*.pcapng
*.usbio.log*

# --- Build output -------------------------------------------------------------------------------
/target/
**/*.rs.bk
*.pdb
# Coverage and profiling.
*.profraw
*.profdata
lcov.info
tarpaulin-report.*
/coverage/
# JavaScript tools (the site has its own .gitignore for its output).
node_modules/
.wrangler/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# --- Editors and operating systems --------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
.fleet/
.zed/
*.code-workspace
*.swp
*.swo
*~
.#*
\#*#

# --- Logs and temporary files -------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
